
:- use_argumentation_theory.

@{p(?x)}  // all descriptor vars are safe
head(?y) :- pp(?y),qq(?x).

@{p(?y)}
head(?x) :- pp(?x),qq(?y).

//?- insertrule{ (@{p(?x,?zz,?ww)} head2(?y) :- pp(?y),qq(?x)) }.
?- catch{insertrule{(@{p(?x,?zz,?ww)} head2(?y) :- pp(?y),qq(?x)) }, ?_Ball, 
          (writeln(2, = '### User-captured ERROR: unsafe variable \'?zz, ?ww\' in the descriptor of the rule inserted on Line ' || \@L || ' in file ' || \@F || ', rule Id: ' || ?RuleId)@\plg, 
            ?_Ball= '_$ergo:abort_notrace'(?_Msg,?_Trace)@\plg,
          writeln(2, msg_in_the_error_ball=?_Msg)@\plg
          )}.

//?- insertrule{ (@{p(?x,?zz,?ww)} head2(?y,?www) :- pp(?y),qq(?x,?zz,?kkk)) }.
?- catch{insertrule{(@{p(?x,?zz,?ww)} head2(?y,?www) :- pp(?y),qq(?x,?zz,?kkk)) }, ?_Ball, 
          (writeln(2, = '### User-captured ERROR: unsafe variable \'?zz, ?ww\' in the descriptor of the rule inserted on Line ' || \@L || ' in file ' || \@F || ', rule Id: ' || ?RuleId)@\plg, 
            ?_Ball= '_$ergo:abort_notrace'(?_Msg,?_Trace)@\plg,
          writeln(2, msg_in_the_error_ball=?_Msg)@\plg
          )}.

?- insertrule{ (@{p(?x,?zz)} head2(?y,?www) :- pp(?y),qq(?x,?zz,?kkk)) }.

pp(1). pp(3). pp(4), pp(6).
qq({2,3,5,6}).

dom(?X) :- ?X \in 1..9.

\opposes(head(?X),head(?X)) :-
        %enabled,
        pp(?X),
        qq(?X).

%disable :- \+%disabled, insert{%disabled}, 
              abolish_all_tables@\plg.
%enable  :- %disabled, delete{%disabled},
              abolish_all_tables@\plg.
%enabled :- \+%disabled.

   ?- head(?x),           // ?x = 1,4  opposition enabled,
      writeln(x=?x)@\plg.  // head(3), head(6) beat themselves so
                          // 1 , 4 returned
   ?- %disable.
   ?- head(?x),            // ?x = 1,3,4,6  opposition disabled, so
      writeln(x=?x)@\plg.  // We addl return the defeated answers 3 and 6 

//?- %disable.
//?- %enable.
