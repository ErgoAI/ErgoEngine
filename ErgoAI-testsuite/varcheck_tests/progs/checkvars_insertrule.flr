
:- use_argumentation_theory.

?- ?_Hook = ${?_Ball= '_$ergo:abort_notrace'(?_Msg,?_Trace)@\plg,
               writeln(2, = '\n++Abort[Ergo]: ' || ?_Msg)@\plg} ,
        catch{insert{@{ppp(?x,?zzz,?kkk)} another4(?y,?zzz123) :- pp(?y),qq(?x) },
          ?_Ball,
          ?_Hook}.


?- ?_Hook = ${?_Ball= '_$ergo:abort_notrace'(?_Msg,?_Trace)@\plg,
               writeln(2, ='\n++Abort[Ergo]: ' || ?_Msg)@\plg} ,
        catch{insertrule{@{ppp(?x,?y,?x,?y)} another5(?y,?zzz123) :- pp(?y),qq(?x) },
          ?_Ball,
          ?_Hook}.

?- ?_Hook = ${?_Ball= '_$ergo:abort_notrace'(?_Msg,?_Trace)@\plg,
               writeln(2, ='\n++Abort[Ergo]: ' || ?_Msg)@\plg} ,
        catch{insertrule{@{ppp(?x,?zzz,?x,?kkk)} another5(?y,?zzz123) :- pp(?y),qq(?x) },
          ?_Ball,
          ?_Hook}.

pp({2,3}).
qq({1,2}).



?- ?_Hook = ${?_Ball= '_$ergo:abort_notrace'(?_Msg,?_Trace)@\plg,
               writeln(2, ='\n++Abort[Ergo]: ' || ?_Msg)@\plg} ,
        // note: The vars in the descr are silent, so  they cause neither errors nor warnings
        catch{insertrule{@{qqq(?_x,?_zzz,?_kkk)} another6(?y,?zzz123) },
          ?_Ball,
          ?_Hook}.


?- ?_Hook = ${?_Ball= '_$ergo:abort_notrace'(?_Msg,?_Trace)@\plg,
               writeln(2, = '\n++Abort[Ergo]: ' || ?_Msg)@\plg} ,

        catch{insert{@{ppp(?x,?zzz,?kkk)} another4(?y,?zzz123) :- pp(?y),qq(?x) },
          ?_Ball,
          ?_Hook}.


?- ?_Hook = ${?_Ball= '_$ergo:abort_notrace'(?_Msg,?_Trace)@\plg,
               writeln(2, = '\n++Abort[Ergo]: ' || ?_Msg)@\plg} ,

        catch{insertrule{@{qqq(?zzz,?www)} another6(?yyyy,?xxxx) },
          ?_Ball,
          ?_Hook}.

