
:- use_argumentation_theory.


\udf foo(?x):=?y \if fooDef(?x,?y).
\udf goo(?x):=?y \if ?y \is ?x*2.

fooDef(1,a).
fooDef(2,b).
fooDef(3,c).
fooDef(4,d).
fooDef(5,e).
fooDef(6,f).     pp({2,3,4,6}).
fooDef(7,g).
fooDef(8,h).
fooDef(9,i).
fooDef(10,k).    qq({a,c,e,f,k,m},7).
fooDef(11,m).    qq({a,c,d,f,g,i,k}, 5).

@{aaa(foo(?x),?w)}
rr(goo(?x),?w) :- pp(?w), qq(foo(?w),?x).

?- insert{enabled}.
//?- abolish_all_tables@\plg.

\opposes(aaa(7,6),rr(?,?), aaa(7,6),rr(?,?)) :- enabled.

?- writeln(2, 'Query 1: safe+enabled, rr(?x,?y,?)')@\plg.
?- writeln(6 /* STDFDBK */, 'Query 1: safe+enabled, rr(?x,?y,?)')@\plg.

?- rr(?x,?y),
        //!!,  // to stop delay
        writeln(2, = (x=?x) || '   ' || (y=?y) || ' sf1-true ')@\plg.

?- delete{enabled}.
//?- abolish_all_tables@\plg.

?- writeln(2, 'Query 2: safe+disabled, rr(?x,?y,?)')@\plg.
?- writeln(6 /* STDFDBK */, 'Query 2: safe+disabled, rr(?x,?y,?)')@\plg.

?- rr(?x,?y),
        //!!,  // to stop delay
        writeln(2, = (x=?x) || '    ' || (y=?y) || ' sf2-true ')@\plg.


