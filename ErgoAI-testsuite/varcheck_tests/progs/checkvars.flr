
:- use_argumentation_theory.

@{TAG(?Tagbodyhead,?Tagonly,?Taghead,?Tagbody)}
HEAD(?Tagbodyhead,?Headonly,?Taghead,?Headbody) :- BODY(?Tagbodyhead,?Bodyonly,?Tagbody,?Headbody).

/*
   Warnings:
    `?Bodyonly' singleton variable
    `?Headonly' singleton variable
    `?Tagbody'  singleton variable  should not be a warning
    `?Taghead'  the singleton variable  should be unsafe var
    `?Headonly' unsafe variable in rule head
    `?Taghead'  unsafe variable in rule head 
    `Tagonly'   should be an error - annotation-only vars not  allowed, not meaningful
*/


@{p(?x,?z,?w)} head(?y) :- pp(?y),qq(?x).
