

%tst1 :- 'data/json2file_test2.json'[parse2file(temp)]@\json.
%test_load :-
        (File[unlink('temp.ergo')]@\io ; \true),
        File[link(temp,'temp.ergo')]@\io,
        writeln('testing whether temp.ergo loads')@\plg,
        [temp>>testmod],
        writeln('temp.ergo loads fine')@\plg,
        \true.

%test :- %tst1,
        %test_load.
